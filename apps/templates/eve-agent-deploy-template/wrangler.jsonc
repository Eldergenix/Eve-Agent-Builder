{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "eve-agent",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-19",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
}
